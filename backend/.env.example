# Copy this file to .env and change the values
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# Default = SQLite (no setup needed). Other options:
DATABASE_URL=sqlite:///./chat.db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/chat_db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/chat_db
